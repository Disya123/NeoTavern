{
  "name": "@neotavern/client-sdk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Remote-access SDK: typed calls, event streaming and protocol handshake over the product wire contract",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "clean": "tsc -b --clean"
  },
  "dependencies": {
    "@neotavern/contracts": "workspace:*",
    "@sinclair/typebox": "^0.34.52"
  }
}
