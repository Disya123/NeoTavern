{
  "name": "@neotavern/plugin-build",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Plugin SDK vNext build/publish pipeline: neotavern-plugin analyze/sign/build",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "neotavern-plugin": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "clean": "tsc -b --clean"
  },
  "dependencies": {
    "@neotavern/plugin-runtime": "workspace:*",
    "@neotavern/plugin-sdk": "workspace:*",
    "@neotavern/shared": "workspace:*",
    "typescript": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:"
  }
}
