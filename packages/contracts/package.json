{
  "name": "@neotavern/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared TypeBox schemas and API contracts (single source of truth)",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "clean": "tsc -b --clean"
  },
  "dependencies": {
    "@neotavern/shared": "workspace:*",
    "@sinclair/typebox": "^0.34.52"
  },
  "devDependencies": {
    "fast-check": "^4.9.0"
  }
}
