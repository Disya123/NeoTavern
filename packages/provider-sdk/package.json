{
  "name": "@neotavern/provider-sdk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Provider adapter contract and adapters (LLM/TTS/STT/image)",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "clean": "tsc -b --clean"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@neotavern/contracts": "workspace:*",
    "@neotavern/shared": "workspace:*",
    "js-tiktoken": "^1.0.21"
  }
}
