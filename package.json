{
  "name": "neotavern",
  "version": "0.1.0",
  "private": true,
  "description": "NeoTavern — local-first AI chat frontend/backend monorepo",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=24",
    "pnpm": ">=9 <10"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json && pnpm --filter @neotavern/server assets && pnpm --filter @neotavern/web build",
    "desktop:prepare": "node scripts/prepare-desktop.mjs",
    "desktop:smoke": "node scripts/smoke-desktop-sidecar.mjs",
    "desktop:portable:package": "node scripts/package-portable-windows.mjs",
    "desktop:shell-smoke": "node scripts/smoke-desktop-shell.mjs",
    "desktop:bundle:smoke": "node scripts/smoke-desktop-bundle.mjs",
    "desktop:portable": "pnpm desktop:build && pnpm desktop:portable:package && pnpm desktop:shell-smoke",
    "desktop:dev": "pnpm --filter @neotavern/desktop dev",
    "desktop:build": "pnpm --filter @neotavern/desktop build",
    "desktop:release": "pnpm desktop:prepare && node scripts/build-desktop-release.mjs && node scripts/smoke-desktop-release.mjs",
    "typecheck": "tsc -b tsconfig.build.json && pnpm --filter @neotavern/ui typecheck && pnpm --filter @neotavern/i18n typecheck && pnpm --filter @neotavern/legacy-compat typecheck && pnpm --filter @neotavern/web typecheck",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run && pnpm --filter @neotavern/web test",
    "test:watch": "vitest",
    "test:e2e": "pnpm --filter @neotavern/client-sdk build && pnpm --filter @neotavern/neobackend build && pnpm --filter @neotavern/web build && cargo build --manifest-path crates/Cargo.toml -p neotavern-headless && node scripts/run-e2e-parallel.mjs",
    "test:e2e:legacy": "pnpm build && node scripts/run-e2e-parallel.mjs --config=playwright.legacy.config.ts",
    "test:e2e:headless": "pnpm --filter @neotavern/client-sdk build && pnpm --filter @neotavern/neobackend build && pnpm --filter @neotavern/web build && cargo build --manifest-path crates/Cargo.toml -p neotavern-headless && pnpm exec playwright test -c playwright.headless.config.ts",
    "docs:check": "node scripts/docs-check.mjs",
    "docs:build": "node scripts/docs-build.mjs",
    "docs:sync": "node scripts/docs-sync.mjs",
    "docs:sync:check": "node scripts/docs-sync.mjs --check",
    "milestone:gates": "node scripts/check-milestone-gates.mjs",
    "milestone:gates:check": "node scripts/check-milestone-gates.mjs --check && node scripts/check-milestone-gates.mjs --self-test",
    "milestone:b-exit": "node scripts/milestone-b-exit.mjs --check",
    "contained:run": "node scripts/contained-run.mjs",
    "test:contracts:heavy": "node scripts/contained-run.mjs --cap 4096 --min-cap 2048 --deadline 900 --lock neota-heavy -- pnpm exec vitest run packages/contracts/test/fuzz.test.ts packages/contracts/test/bench.test.ts",
    "test:rust-fuzz:contained": "node scripts/contained-run.mjs --cap 4096 --min-cap 2048 --deadline 900 --lock neota-heavy -- cargo test --manifest-path crates\\Cargo.toml -p contracts-generated --test fuzz_deserialization",
    "docs:site": "pnpm --filter @neotavern/docs start",
    "docs:site:build": "node scripts/docs-sync.mjs && pnpm --filter @neotavern/docs build",
    "docs:translations": "pnpm --filter @neotavern/docs write-translations",
    "theme:starter": "node scripts/build-theme-starter.mjs",
    "theme:previews": "node scripts/build-theme-previews.mjs",
    "design:pack": "python crates/presentation-design-system/scripts/pack_design_system.py",
    "design:pack:check": "python crates/presentation-design-system/scripts/pack_design_system.py --check",
    "design:watch": "node scripts/watch-design-system.mjs",
    "style:golden-diff": "node scripts/style-golden-diff.mjs",
    "blueprint:validate": "node packages/contracts/tools/validate-document.mjs",
    "blueprint-preview": "node scripts/blueprint-preview.mjs",
    "blueprint:packaged-check": "node scripts/blueprint-packaged-check.mjs",
    "ui:dev": "node scripts/ui-dev.mjs",
    "ui:schema": "node packages/contracts/tools/export-json-schema.mjs",
    "ui:schema:check": "node packages/contracts/tools/export-json-schema.mjs --check",
    "chat:golden": "node scripts/chat-golden.mjs capture",
    "chat:golden:check": "node scripts/chat-golden.mjs check",
    "dom:dump-react": "node scripts/dom-parity/dump-react.mjs",
    "dom:parity": "node scripts/dom-parity/compare.mjs",
    "dev": "pnpm --parallel --filter @neotavern/server --filter @neotavern/web dev",
    "dev:server": "pnpm --filter @neotavern/server dev",
    "dev:web": "pnpm --filter @neotavern/web dev",
    "start": "pnpm --filter @neotavern/server start",
    "db:generate": "pnpm --filter @neotavern/db db:generate",
    "db:migrate": "pnpm --filter @neotavern/db db:migrate",
    "benchmark": "pnpm --filter @neotavern/db db:benchmark",
    "contracts:generate": "node tools/contract-codegen/codegen.mjs",
    "contracts:check": "node tools/contract-codegen/codegen.mjs --check",
    "contracts:diff": "node tools/contract-codegen/diff.mjs",
    "capability:matrix": "node tools/capability-matrix/generate.mjs",
    "capability:matrix:check": "node tools/capability-matrix/generate.mjs --check",
    "ui:api:check": "node scripts/check-ui-api.mjs --check",
    "ui:api:update": "node scripts/check-ui-api.mjs --update",
    "crates:test": "cargo test --manifest-path crates/Cargo.toml",
    "crates:test:adapter": "cargo test --manifest-path crates/Cargo.toml -p remote-http-adapter",
    "upgrade:drill": "node scripts/upgrade-drill.mjs",
    "clean": "node scripts/clean.mjs",
    "kernel:dispatch:check": "node scripts/check-kernel-dispatch.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.49.1",
    "@tauri-apps/cli": "^2",
    "@types/node": "catalog:",
    "@yao-pkg/pkg": "^6.21.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "typescript": "catalog:",
    "typescript-eslint": "^8.18.2",
    "vitest": "^4.1.10"
  }
}
