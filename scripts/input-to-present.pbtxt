buffers {
  size_kb: 262144
  fill_policy: RING_BUFFER
}
buffers {
  size_kb: 32768
  fill_policy: RING_BUFFER
}
duration_ms: 180000

data_sources {
  config {
    name: "linux.ftrace"
    target_buffer: 0
    ftrace_config {
      atrace_categories: "gfx"
      atrace_categories: "view"
      atrace_categories: "input"
      atrace_apps: "com.neotavern.mobile"
      atrace_apps: "surfaceflinger"
    }
  }
}

data_sources {
  config {
    name: "android.surfaceflinger.frametimeline"
    target_buffer: 0
  }
}

data_sources {
  config {
    name: "android.log"
    target_buffer: 1
    android_log_config {
      log_ids: LID_DEFAULT
      log_ids: LID_SYSTEM
      filter_tags: "NeoTavernI2P"
      min_prio: PRIO_INFO
    }
  }
}
