{
  "index_name": "neotavern",
  "start_urls": [{ "url": "https://docs.neotavern.com/", "selectors_key": "docs" }],
  "sitemap_urls": ["https://docs.neotavern.com/sitemap.xml"],
  "sitemap_alternate_links": true,
  "stop_urls": [],
  "selectors": {
    "docs": {
      "lvl0": {
        "selector": "header h1, article h1",
        "global": true,
        "default_value": "Documentation"
      },
      "lvl1": "article h1",
      "lvl2": "article h2",
      "lvl3": "article h3",
      "lvl4": "article h4",
      "lvl5": "article h5, article td:first-child",
      "lvl6": "article h6",
      "text": "article p, article li, article code, article pre"
    }
  },
  "selectors_exclude": ["header", "footer", "nav", ".theme-doc-breadcrumbs"],
  "min_indexed_level": 2,
  "nb_hits": 50000
}
