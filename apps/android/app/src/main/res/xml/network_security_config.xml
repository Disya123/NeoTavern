<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Headless / Desktop Remote Access speak plaintext HTTP on the bound
         socket (ADR-0030: TLS is the operator's proxy). The Android host
         must reach a LAN IP the user typed or scanned (HostConnect QR or
         manual URL, e.g. http://192.168.1.42: randomization). Pairing bearer
         + CORS (opaque Origin: null only when auth is on) remain the gates;
         this config only permits cleartext, it does not open /rpc.

         Broad base-config is intentional: domain-config cannot cover arbitrary
         LAN IPs (192.168.x.x, 10.x.x.x). Emulator localhost (10.0.2.2 /
         10.0.3.2) is also a literal IP, not a DNS name. Narrowing to
         <domain-config> for localhost alone would break LAN pairing, so the
         global permit stays until a future ADR can scope it to
         user-confirmed hosts. See ADR-0030 and docs/adr/0052-webview-removal.md
         for the cutover scope (WebView remains only in WebSurface). -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <!-- Explicit localhost entries for audit clarity; they are covered by the
         base-config but document the intended pairing endpoints. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">10.0.3.2</domain>
    </domain-config>
</network-security-config>
