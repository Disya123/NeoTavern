<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Native chrome only (status/nav/window). The product UI is the bundled
         web app styled through the Theme SDK (st-* design tokens). Window
         background matches the web dark theme-color so the first paint
         before WebView load is not a light Material stub. -->
    <style name="Theme.NeoTavern" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">#151311</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
