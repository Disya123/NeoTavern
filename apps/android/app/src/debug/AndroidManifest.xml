<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Debug/probe variant only. Production `main`/`release` must not declare
         this. Optional: physical D1a prefers wgpu Vulkan. required=false so
         GLES fallback devices still install; AGI capture uses -api vulkan. -->
    <uses-feature
        android:name="android.hardware.vulkan.level"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.vulkan.version"
        android:required="false"
        android:version="0x00401000" />

    <application>
        <!-- Debug-only; not a launcher. Production MainActivity is unchanged. -->
        <activity
            android:name=".M0D1aActivity"
            android:exported="true"
            android:label="M0-D1a probe">
            <!-- MAIN+DEFAULT without LAUNCHER: AGI `gapit packages` only lists
                 activities with an action URI. Not a home-screen entry;
                 production MainActivity stays the launcher. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity
            android:name=".M0D1bActivity"
            android:exported="true"
            android:label="M0-D1b probe">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity
            android:name=".M0D2Activity"
            android:exported="true"
            android:label="M0-D2 probe">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity
            android:name=".PresentationPerfActivity"
            android:exported="true"
            android:label="PERF-18-20 probe">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity
            android:name=".PresentationInputActivity"
            android:exported="true"
            android:label="Input adapter probe">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity
            android:name=".PresentationSurfaceActivity"
            android:exported="true"
            android:label="PERF-22 surface probe">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity
            android:name=".PresentationChatActivity"
            android:exported="true"
            android:label="Flagged Dioxus chat"
            android:resizeableActivity="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>
    <!-- targetSdk >= 30 hides other packages from the Vulkan loader unless
         listed here. Debug/probe only; production main manifest is unchanged. -->
    <queries>
        <package android:name="org.renderdoc.renderdoccmd.arm64" />
        <package android:name="org.renderdoc.renderdoccmd.arm32" />
    </queries>
</manifest>
