{
  "id": "neotavern.github-dark",
  "name": "GitHub Dark",
  "version": "1.0.0",
  "apiVersion": 1,
  "modes": ["dark"],
  "tokens": {
    "dark": {
      "color-text-primary": "#e6edf3",
      "color-text-secondary": "#9198a1",
      "color-text-muted": "#6e7681",
      "color-text-inverse": "#0d1117",
      "color-text-link": "#4493f8",
      "color-surface-primary": "#010409",
      "color-surface-secondary": "#0d1117",
      "color-surface-tertiary": "#161b22",
      "color-surface-overlay": "#161b22",
      "color-surface-canvas": "#010409",
      "color-surface-elevated": "#1c2128",
      "color-accent": "#2f81f7",
      "color-accent-hover": "#4493f8",
      "color-accent-text": "#ffffff",
      "color-accent-soft": "#0d2847",
      "color-accent-soft-text": "#79c0ff",
      "color-border": "#30363d",
      "color-border-strong": "#6e7681",
      "color-success": "#3fb950",
      "color-warning": "#d29922",
      "color-danger": "#f85149",
      "color-info": "#2f81f7",
      "color-message-quote": "#d29922",
      "color-message-emphasis": "#9198a1",
      "color-message-code": "#e6edf3",
      "color-message-code-bg": "#161b22",
      "shadow-card": "0 1px 2px rgba(1, 4, 9, 0.45)",
      "shadow-soft": "0 10px 28px rgba(1, 4, 9, 0.4)",
      "shadow-focus": "0 0 0 3px rgba(47, 129, 247, 0.3)",
      "shadow-overlay": "0 24px 64px rgba(1, 4, 9, 0.6)",
      "chat-wallpaper-overlay": "rgba(1, 4, 9, 0.55)"
    }
  },
  "componentsCss": "components.css",
  "shell": "shell.css",
  "preview": "preview.png",
  "shellLayout": {
    "managementTabs": {
      "pinned": false
    },
    "navigationRail": {
      "main": [
        "menu-toggle",
        "chats",
        "characters",
        "personas",
        "lorebooks",
        "ai-settings",
        "plugins",
        "settings"
      ],
      "bottom": []
    }
  },
  "settings": {}
}
