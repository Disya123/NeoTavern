{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NeoTavern",
  "version": "0.1.0",
  "identifier": "app.neotavern.v2",
  "build": {
    "beforeBuildCommand": "pnpm --dir ../.. desktop:prepare",
    "beforeDevCommand": "pnpm --dir ../.. desktop:prepare",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self'; font-src 'self' data:; object-src 'none'; base-uri 'self'; frame-ancestors 'self'"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE1NDFEN0Y1ODE5OERGODIKUldTQzM1aUI5ZGRCcFNUU3NsdmFUSE0yZ0ZkRm4vVFVFZjVqbnA2dS9IbTJpdFJSMmNuaFl4em8K"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/neotavern-server"
    ],
    "resources": [
      "resources/web/**/*",
      "resources/native/**/*",
      "resources/runtime/**/*"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "linux": {
      "rpm": {
        "compression": {
          "type": "none"
        }
      }
    }
  }
}
