+fn neoui_glass_marker(node: &Node, scale: f64) -> Option<HostNodeMarker> {
+    let data = node.element_data()?;
+    let is_glass = data.attrs.iter().any(|attr| {
+        (*attr.name.local == *"data-neoui" && attr.value == "glass")
+            || (*attr.name.local == *"class"
+                && attr
+                    .value
+                    .split_whitespace()
+                    .any(|token| token == "neoui-glass"))
+    });
+    if !is_glass {
+        return None;
+    }
+    let layout = node.final_layout;
+    let x = layout.location.x as f64 * scale;
+    let y = layout.location.y as f64 * scale;
+    let width = layout.size.width as f64 * scale;
+    let height = layout.size.height as f64 * scale;
+    Some(HostNodeMarker {
+        node_id: node.id as u64,
+        kind: HostNodeKind::Glass,
+        bounds: Rect::new(x, y, x + width.max(1.0), y + height.max(1.0)),
+    })
+}
