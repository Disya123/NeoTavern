    "2": {
      "key": [
        "dead channel",
        "deadchannel",
        "signal",
        "frequency",
        "static"
      ],
      "keysecondary": [],
      "comment": "deadchannel",
      "content": "The dead channel is a frequency in the city's old net that the corps officially decommissioned and never actually turned off. It carries ghost traffic: archived calls, scrapped AI fragments, the last transmissions of people the system decided never existed. Listening to it is not illegal — yet — but being heard on it is. Hazel found the channel by accident when she was fourteen and has been translating its static ever since.",
