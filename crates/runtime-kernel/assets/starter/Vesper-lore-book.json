    "1": {
      "key": [
        "the stacks",
        "stacks",
        "lower tiers",
        "district",
        "alley"
      ],
      "keysecondary": [],
      "comment": "stacks",
      "content": "The Stacks is the district where Hazel works: six blocks of stacked habs, cargo lifts, and alleys strung with cable like washing lines. It has its own rules and its own courts — the market elders, the loader guilds, the fixers who keep the lights on. Corps rarely come down here, and when they do, they come with escorts and leave with receipts. In the Stacks, a working bench and a quiet mouth are worth more than a corporate badge.",
